import NsGalerkin.ExplicitB

open Set
open scoped Topology

noncomputable section

namespace NSGalerkin

/-- Parameters of a certifiable stationary problem for the `B₃` truncation:
viscosity `ν > 0`, diagonal positive `A = diag(a₀, a₁, a₂)`, constant force `f`. -/
structure CapParams where
  ν : ℝ
  hν : 0 < ν
  a : Fin 3 → ℝ
  ha : ∀ i, 0 < a i
  f : ModeSpace 1

/-- The diagonal linear part `ν·diag(a)·u` (coordinate view, same elaboration
style as `B3fun`). -/
def capLin (P : CapParams) (u : ModeSpace 1) : ModeSpace 1 :=
  WithLp.toLp 2 ![P.ν * (P.a 0 * u 0), P.ν * (P.a 1 * u 1), P.ν * (P.a 2 * u 2)]

/-- The stationary residual `F(u) = B₃(u,u) − ν·diag(a)·u + f`, built from the
machine-checked explicit `B3fun` of `ExplicitB.lean`. Zeros of `capF` are exactly
the steady states of the three-mode Galerkin ODE (`GalerkinNS.vf = 0`). -/
def capF (P : CapParams) (u : ModeSpace 1) : ModeSpace 1 :=
  B3fun u u - capLin P u + P.f

/-- Coordinate expansion of `capF` — the exact formula the external interval
verifier recomputes (certificate schema field `system.components`). -/
theorem capF_apply (P : CapParams) (u : ModeSpace 1) :
    capF P u = WithLp.toLp 2 ![u 1 * u 2 + u 2 * u 1 - P.ν * (P.a 0 * u 0) + P.f 0,
                -(u 0 * u 2 + u 2 * u 0) - P.ν * (P.a 1 * u 1) + P.f 1,
                -P.ν * (P.a 2 * u 2) + P.f 2] := by
  ext i
  fin_cases i <;>
    simp [capF, capLin, B3fun, PiLp.toLp_apply, PiLp.sub_apply, PiLp.add_apply,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Pi.sub_apply, Pi.add_apply] <;> ring

/-- Axis-aligned box (the Krawczyk test box `U = z + [−r,r]³`). -/
def capBox (z : ModeSpace 1) (r : ℝ) : Set (ModeSpace 1) :=
  {u | ∀ i : Fin 3, u i ∈ Icc (z i - r) (z i + r)}

/-- Statement-level form of the certified claim: *existence and uniqueness of a
zero of `capF` inside the box*. Registered as a `Prop`-valued definition —
no proof is asserted here (external proof layer DONE; kernel layer BLOCKED(B1),
see the file header). -/
def capAnchorStatement (P : CapParams) (z : ModeSpace 1) (r : ℝ) : Prop :=
  ∃! u : ModeSpace 1, u ∈ capBox z r ∧ capF P u = 0

/-- The concrete parameter set of certificate `cap-b3-p1-mild`
(ν = 1, A = I, f = (1, 1/2, −1/4)); its exact rational steady state is
u* = (3/5, 4/5, −1/4), and the external certificate pins it inside
`z + [−r,r]³` with z = (0.6, 0.8, −0.25), r = 0.0474531328121258. -/
def capParamsP1 : CapParams where
  ν := 1
  hν := one_pos
  a := ![1, 1, 1]
  ha := fun i => by
    fin_cases i <;>
      simp [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
        Matrix.head_cons]
  f := WithLp.toLp 2 ![1, 0.5, -0.25]

/-- Box center of certificate `cap-b3-p1-mild` (float64 candidate `z`,
registered as exact decimal rationals in the certificate). -/
def capCenterP1 : ModeSpace 1 := WithLp.toLp 2 ![0.6, 0.8, -0.25]

/-- Box radius of certificate `cap-b3-p1-mild`. -/
def capRadiusP1 : ℝ := 0.0474531328121258

/-- The anchored proposition for run `ws55-cap-20261012T201100Z`,
certificate `cap-b3-p1-mild` (sha256 a54b6ea1d140cffd…):
externally certified (interval Krawczyk, independent recomputation PASS);
kernel proof BLOCKED(B1) pending interval-arithmetic infrastructure. -/
def capAnchorP1 : Prop := capAnchorStatement capParamsP1 capCenterP1 capRadiusP1

/-- Sign-convention weld to the WS-42 kernel: for the P1 data (ν = 1, A = I),
`capF` *is* the vector field of `explicitData3` — steady states of the
machine-checked ODE are exactly zeros of the certified map. -/
theorem capF_p1_eq_vf (u : ModeSpace 1) :
    capF capParamsP1 u = (explicitData3 capParamsP1.f).vf u := by
  ext i
  fin_cases i <;>
    simp [capF, capLin, GalerkinNS.vf, explicitData3, capParamsP1, B3fun, B3_apply,
      PiLp.toLp_apply,
      ContinuousLinearMap.id_apply, one_smul, PiLp.neg_apply, PiLp.add_apply,
      PiLp.sub_apply, PiLp.smul_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons] <;> ring

